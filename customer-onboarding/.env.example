# Front-end default KYC vendor (sent to /api/kyc/*): onfido | persona | jumio
VITE_KYC_VENDOR=persona
# For a SPLIT deploy (SPA on Cloudflare Pages, API elsewhere), set the absolute
# API base. Leave unset for a single-service deploy where /api is same-origin.
# VITE_API_URL=https://customer-onboarding-api.onrender.com
